# rembg 同梱用 Python（python-build-standalone を bundle-rembg が展開・rembg を pip install）
resources/bundled-rembg/*/python/
# 旧 venv 構造（後方互換のため ignore を残す）
resources/bundled-rembg/*/venv/
# invoke-rembg.py の正は resources/bundled-rembg/invoke-rembg.py（bundle-rembg が各 OS フォルダへコピー）
resources/bundled-rembg/*/invoke-rembg.py
